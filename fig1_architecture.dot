digraph Architecture {
    rankdir=LR;
    splines=ortho;
    nodesep=0.8;
    ranksep=1.2;
    fontsize=11;
    fontname="Helvetica";
    
    // Global graph attributes
    compound=true;
    concentrate=false;
    
    // Node styles
    node [shape=box, style="filled,rounded", fillcolor="#f8f9fa", 
          color="#2c3e50", fontcolor="#2c3e50", fontsize=10, 
          fontname="Helvetica", margin="0.2,0.15"];
    
    edge [color="#34495e", fontcolor="#7f8c8d", fontsize=9, 
          fontname="Helvetica", penwidth=1.2];
    
    // Column 1: Data & Embedding
    subgraph cluster_data {
        label="DATA & EMBEDDING";
        style="dashed";
        color="#95a5a6";
        fontcolor="#7f8c8d";
        fontsize=11;
        
        NHANES [label="NHANES 2017-2018
5,533 adults
18.6% diabetes"];
        Exclude [label="Exclude HbA1c/Glucose
(avoid circularity)"];
        ECDF [label="Clinical Feature
Embedder (ECDF -> z-space)"];
        Split [label="4-Way Split
50%/15%/15%/20%
Train/Platt/Conf+Audit/Test"];
    }
    
    // Column 2: Core Models
    subgraph cluster_models {
        label="CORE STATISTICAL TOOLS";
        style="dashed";
        color="#3498db";
        fontcolor="#2980b9";
        fontsize=11;
        
        LR [label="Calibrated Risk
Predictor
Logistic Reg + Platt"];
        Conformal [label="Conformal Calibrator
(Split, 15% held-out)
EB-MinCov + DKW Guardrail"];
        QCQP [label="QCQP Counterfactual
Solver
Ledoit-Wolf Ellipsoid
Binary: z_i+d in {0,1}"];
        Wald [label="Attribution Tester
(Wald + BH FDR 10%)
Inference-valid"];
        Auditor [label="Deployable Auditor
Val Coverage + ECE
Abstention gate"];
    }
    
    // Column 3: Agentic Loops
    subgraph cluster_agentic {
        label="AGENTIC LOOPS";
        style="dashed";
        color="#e74c3c";
        fontcolor="#c0392b";
        fontsize=11;
        
        Orchestrator [label="Orchestrator Agent
Loop 1: Counterfactual
Recovery (Tier 1->2->3,
Radius 1.0->1.5->2.0x)"];
        Synthesis [label="Synthesis Agent
(LLM: Qwen2.5-1.5B/7B)
Schema -> Narrative"];
        Verifier [label="Verifier Agent
Loop 2: Narrative
Verification & Repair
(M=3 retries)"];
    }
    
    // Column 4: Outputs
    subgraph cluster_outputs {
        label="OUTPUTS & GUARANTEES";
        style="dashed";
        color="#27ae60";
        fontcolor="#1e8c49";
        fontsize=11;
        
        PredSet [label="Valid Prediction Sets
90% Coverage
(Finite-sample)"];
        Counterfactual [label="Actionable Counterfactuals
100% Reach
100% Ellipsoid Containment"];
        Attribution [label="Calibrated Attribution
FDR-controlled
Inference-valid"];
        Narrative [label="Verified Clinician
Explanation
94.2% LLM+Loop2
(n=86, seed 3)"];
    }
    
    // Edges with orthogonal routing
    NHANES -> Exclude -> ECDF -> Split;
    
    Split -> LR -> Conformal;
    Split -> QCQP;
    Split -> Wald;
    Split -> Auditor;
    
    LR -> Conformal;
    Conformal -> QCQP;
    Conformal -> Wald;
    Conformal -> Auditor;
    
    QCQP -> Orchestrator;
    Conformal -> Orchestrator;
    Wald -> Orchestrator;
    Auditor -> Orchestrator;
    
    Orchestrator -> Synthesis;
    Synthesis -> Verifier;
    Verifier -> Synthesis [label="M=3 retries
Error trace", style=dashed, color="#e74c3c"];
    
    // Outputs
    Conformal -> PredSet;
    Orchestrator -> Counterfactual;
    Wald -> Attribution;
    Verifier -> Narrative;
    
    // Rank constraints for column layout
    {rank=same; NHANES; Exclude; ECDF; Split}
    {rank=same; LR; Conformal; QCQP; Wald; Auditor}
    {rank=same; Orchestrator; Synthesis; Verifier}
    {rank=same; PredSet; Counterfactual; Attribution; Narrative}
}
